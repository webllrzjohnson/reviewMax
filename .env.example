# ------------------------------------------------------------------------------
# ReviewMax — copy to `.env.local` and fill with your project values.
# ------------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
WEBHOOK_SECRET=generate_a_long_random_string

# Optional: n8n HTTP Request node hits this after admin form submit
N8N_REVIEW_WEBHOOK_URL=https://your-n8n.example.com/webhook/review-request

# Analytics & monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Canonical site URL for Open Graph + sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Amazon Associates tracking ID appended to buy links when missing ?tag=
NEXT_PUBLIC_AMAZON_TRACKING_ID=yourstore-20
